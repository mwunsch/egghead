# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
egghead-*.tar

# SQLite index (derived, rebuildable from files)
.egghead/

# Native build artifacts (downloaded/built by mix compile via build_dot_zig)
/priv/*/
!/priv/static/
!/priv/mcp/
!/priv/eval/
!/priv/agents/
/zig-out/
/.zig-cache/

# Burrito builds self-contained binaries here.
/burrito_out/

# Phoenix asset digest outputs (`mix phx.digest`). Source assets
# (app.css, app.js, icons) stay tracked; the cache manifest, gzip
# copies, and fingerprinted "name-<32hex>.ext" variants are regenerated
# every release and shouldn't be committed.
/priv/static/cache_manifest.json
/priv/static/**/*.gz
/priv/static/**/*-????????????????????????????????.*
