#!/bin/bash
# Run Egghead via Mix (requires Erlang/Elixir installed).
#
# For users without BEAM installed, the Burrito binary provides
# the same interface without this script.
#
# +Bd disables the BEAM break handler so Ctrl+C exits cleanly,
# matching the Burrito binary's -noshell behavior.

cd "$(dirname "$0")/.." || exit 1
export ERL_FLAGS="+Bd"
exec mix egghead "$@"
